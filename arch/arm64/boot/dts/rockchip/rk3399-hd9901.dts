/*
 * CMCC HD9901 (HD9901-HD-MB-v2.6) RK3399 board.
 *
 * The vendor Debian image describes this board as a rock960 variant. Relative
 * to rk3399-rock960.dtsi the board has no 96boards LEDs/PCIe/SPI expansion and
 * no DDR3-supported DFI, but adds a RTL8211E gmac, both USB controllers in host
 * mode, the eMMC PHY strobe pull-down and the AP6255 WiFi/BT model strings.
 * Console is UART2 at 1500000n8.  WiFi SDIO is capped at 50 MHz: the 6.18
 * dw_mmc path corrupts the dongle firmware download at 148.5 MHz.
 */

/dts-v1/;

#include "rk3399-rock960.dtsi"

/ {
	model = "CMCC HD9901";
	compatible = "rockchip,rk3399-hd9901", "rockchip,rk3399";

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	clkin_gmac: external-gmac-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "clkin_gmac";
		#clock-cells = <0>;
	};
};

&cpu_alert0 {
	temperature = <65000>;
};

&cpu_thermal {
	sustainable-power = <1550>;

	cooling-maps {
		map0 {
			trip = <&cpu_alert1>;
		};
	};
};

/* no 96boards PCIe expansion connector on this board */
&pcie0 {
	status = "disabled";
};

/* DDR3-800: rockchip-dfi only handles LPDDR2/3/4/4X/5 */
&dfi {
	status = "disabled";
};

&pinctrl {
	pcie {
		pcie_drv: pcie-drv {
			rockchip,pins =
				<2 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb2 {
		/* same pin as &vcc5v0_host below */
		host_vbus_drv: host-vbus-drv {
			rockchip,pins =
				<1 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/* no 96boards LS-SPI0 / HS-SPI1 expansion headers on this board */
&spi0 {
	status = "disabled";
};

&spi4 {
	status = "disabled";
};

/* RTL8211E RGMII: 125 MHz from the on-board oscillator is the MAC input */
&gmac {
	assigned-clocks = <&cru SCLK_RMII_SRC>;
	assigned-clock-parents = <&clkin_gmac>;
	clock_in_out = "input";
	phy-mode = "rgmii";
	phy-supply = <&vcc3v3_sys>;
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii_pins>;
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 10000 50000>;
	tx_delay = <0x28>;
	rx_delay = <0x11>;
	status = "okay";
};

/* HS400 enhanced strobe at the default 200 MHz: 257 MB/s, no CRC errors */
&sdhci {
	bus-width = <8>;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

/* the board has no strobe pull-down resistor; without the PHY pull-down the
 * eMMC CQE queue stalls under write load (write ~1 MB/s, repeated CQE recovery)
 */
&emmc_phy {
	rockchip,enable-strobe-pulldown;
};

/* USB3.0 type-A port */
&usbdrd_dwc3_1 {
	dr_mode = "host";
};

/* type-C port: the board has no role-switch path, so host only as well */
&usbdrd_dwc3_0 {
	dr_mode = "host";
};

&vcc3v3_pcie {
	gpio = <&gpio2 5 GPIO_ACTIVE_HIGH>;
};

&vcc5v0_host {
	gpio = <&gpio1 RK_PA3 GPIO_ACTIVE_HIGH>;
};

/* AP6255 WiFi, BCM43455 on SDIO */
&brcmf {
	compatible = "brcm,bcm43455-fmac";
};

/* 6.18 reads random data back from the dongle firmware at 148.5 MHz SDR104
 * (-84 EILSEQ from dw_mmc); 6.12 works at that clock.  50 MHz is reliable.
 */
&sdio0 {
	max-frequency = <50000000>;
};

/* inherited from rk3399-rock960.dtsi but empty on this board; 6.18 logs
 * "unexpected irq in STOP" for it
 */
&i2c3 {
	status = "disabled";
};

/* AP6255 Bluetooth, BCM4345C5 on UART0 */
&uart0 {
	bluetooth {
		compatible = "brcm,bcm4345c5";
	};
};
